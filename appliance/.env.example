# qmt-mcp runtime config — copy to `.env` and fill in. (`.env` is git-ignored.)
#   cp .env.example .env
# Then: docker compose up -d   (run scripts/harden-check.sh before exposing.)

# --- required ---

# Authentication mode: static (default), oauth, or hybrid.
QMT_MCP_AUTH_MODE=static

# Static bearer for `static` and `hybrid`. Generate a strong random value:
#   openssl rand -hex 32
# OAuth-only mode may leave this empty.
QMT_MCP_TOKEN=

# Path on the host to your broker pack (extracted QMT terminal + matching xtquant
# + broker.yaml). Built with scripts/make-broker-pack.sh. Must be on real disk.
BROKER_PACK=/path/to/brokers/<broker-id>/pack

# --- optional (defaults shown) ---

# Instance name → container is named qmt-<INSTANCE>; use distinct names to run
# several brokers on one host.
INSTANCE=default

# Host ports (host:container). RDP=3389, optional VNC=5900, and MCP=8765 inside
# the container. Desktop ports are loopback-only by default; use a tunnel/VPN.
RDP_BIND_ADDRESS=127.0.0.1
RDP_PORT=13389
VNC_BIND_ADDRESS=127.0.0.1
VNC_PORT=15900
MCP_PORT=18765

# Desktop lifecycle: `manual` waits for the first RDP login; `persistent` creates
# XFCE/QMT/MCP during container startup and reconnects RDP clients to that session.
QMT_DESKTOP_MODE=persistent
QMT_RDP_GEOMETRY=1440x900x32

# RDP password for `wineuser` (>= 12 chars, no default). Prefer mounting a
# Docker secret and setting its in-container path here. Environment input remains
# available for compatibility, but is visible in Docker container metadata.
# QMT_RDP_PASSWORD_FILE=/run/secrets/qmt_rdp_password
QMT_RDP_PASSWORD=

# Clipboard and drive redirection are disabled by default. `text` permits
# text only. Broad clipboard or drive access also requires the explicit unsafe
# channel acknowledgement.
QMT_RDP_CLIPBOARD=none
QMT_RDP_DRIVE_REDIRECTION=0
QMT_RDP_ALLOW_UNSAFE_CHANNELS=0

# Non-loopback publication is an explicit LAN/VPN opt-in. Never publish RDP on
# the public internet.
QMT_RDP_ALLOW_LAN=0

# A unique self-signed TLS identity is generated in the project-scoped volume.
# Set `mounted` plus mounted certificate/key paths to use your own identity.
QMT_RDP_CERT_MODE=generated
# QMT_RDP_CERT_FILE=/run/secrets/qmt_rdp_cert
# QMT_RDP_KEY_FILE=/run/secrets/qmt_rdp_key

# --- optional: VNC client access (027) ---
# Enable with the explicit Compose override, which sets QMT_VNC_ENABLED=1:
#   docker compose -f docker-compose.yml -f docker-compose.vnc.yml up -d
# x11vnc attaches to the same persistent Xorg/QMT desktop as RDP. It never
# creates a separate Xvfb or a second QMT session.
QMT_VNC_ENABLED=0

# Prefer an owner-only mounted secret. If both VNC inputs are empty, the
# resolved RDP password is used for convenience. Classic VNC authentication
# uses only the first 8 characters and does not encrypt the desktop transport.
# Use a unique random value; keep VNC on loopback and connect through SSH/VPN.
# QMT_VNC_PASSWORD_FILE=/run/secrets/qmt_vnc_password
QMT_VNC_PASSWORD=

# Clipboard is disabled by default; `text` permits text selection exchange.
# File transfer and x11vnc remote commands remain disabled in every mode.
QMT_VNC_CLIPBOARD=none
QMT_VNC_RESTART_BACKOFF_S=2

# Non-loopback publication is a trusted-LAN/VPN opt-in and is never supported
# on the public internet.
QMT_VNC_ALLOW_LAN=0

# --- optional: MCP tool profiles (020) ---
# Reduce the advertised/callable tool surface at process startup. Profiles:
# full (default), readonly, market, account, core, custom.
QMT_MCP_TOOL_PROFILE=full
# Optional comma-separated shell globs. An allowlist further narrows a profile;
# a denylist removes matching non-core tools. `custom` requires an allowlist.
QMT_MCP_TOOL_ALLOWLIST=
QMT_MCP_TOOL_DENYLIST=

# --- optional: MCP catalog paging and HTTP compression (022) ---
# Server-selected tools/list page size (1..1000). qmtctl follows every page.
QMT_MCP_LIST_PAGE_SIZE=50
# Compress eligible MCP JSON responses at or above this many bytes. Set 0 when
# an ingress owns compression. SSE is always left uncompressed.
QMT_MCP_GZIP_MIN_SIZE=1024

# --- optional: durable MCP Tasks (023) ---
# MCP 2026-07-28 clients can detach/resume selected long operations. Older and
# non-declaring clients keep synchronous tools/call behavior.
QMT_MCP_TASKS_ENABLED=1
QMT_MCP_TASK_STORE=/broker/cache/mcp-tasks-v1.sqlite3
QMT_MCP_TASK_TTL_MS=86400000
QMT_MCP_TASK_POLL_INTERVAL_MS=1000
QMT_MCP_TASK_MAX_RETAINED=1000
QMT_MCP_TASK_TOOLS=qmt_screen_instruments,qmt_xtdata_download_history,qmt_xtdata_download_history_batch,qmt_xtdata_download_financial_data,qmt_xtdata_formula_call_batch,qmt_xtdata_formula_generate_factor,qmt_xtdata_refresh_instrument_cache

# --- optional: intelligent stock/ETF screening (033) ---
# Current screens need no PostgreSQL. Captured explanations live in a bounded,
# process-local TTL/LRU and disappear on restart. Screening never downloads data.
QMT_SCREEN_MAX_UNIVERSE_CODES=5000
QMT_SCREEN_MAX_FACTOR_REFS=24
QMT_SCREEN_MAX_RESULTS=100
QMT_SCREEN_RESULT_TTL_SECONDS=900
QMT_SCREEN_RESULT_CACHE_MAX=100
QMT_SCREEN_RESULT_CACHE_MAX_BYTES=67108864
QMT_SCREEN_FACTOR_CACHE_MAX=50000

# --- optional: external OAuth authorization (021) ---
# QMT-MCP is the protected resource, not the authorization server. In `oauth`
# or `hybrid`, configure one external issuer and its explicit JWKS endpoint.
# Public deployments require HTTPS; loopback HTTP is accepted for development.
# QMT_MCP_PUBLIC_BASE_URL=https://qmt.example.com
# QMT_MCP_OAUTH_ISSUER=https://auth.example.com
# QMT_MCP_OAUTH_AUTHORIZATION_SERVERS=https://auth.example.com
# QMT_MCP_OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# QMT_MCP_OAUTH_RESOURCE=https://qmt.example.com/mcp
# QMT_MCP_OAUTH_RESOURCE_NAME=QMT MCP
# QMT_MCP_OAUTH_SCOPES=qmt:read qmt:market qmt:account qmt:manage qmt:admin
# QMT_MCP_OAUTH_ALGORITHMS=RS256 ES256
# QMT_MCP_OAUTH_CLOCK_SKEW_S=30
# QMT_MCP_OAUTH_JWKS_TTL_S=300
# QMT_MCP_OAUTH_HTTP_TIMEOUT_S=5
# QMT_MCP_OAUTH_JWKS_MAX_BYTES=1048576

# --- optional: PostgreSQL persistence (012) ---
# Leave empty to keep file/JSONL defaults (no DB). Point at any PostgreSQL, or use
# the bundled `db` service: run `docker compose --profile db up -d` and set:
#   QMT_DB_URL=postgresql://qmt:qmt@db:5432/qmt
QMT_DB_URL=
# Credentials for the bundled `db` service (only used with --profile db):
QMT_DB_USER=qmt
QMT_DB_PASSWORD=qmt
QMT_DB_NAME=qmt

# --- optional: read-only account queries (004) ---
# Enable xttrade read-only account-query tools (asset/positions/orders/trades/...).
# Requires broker "programmatic trading / external Python API" permission
# (m_nPythonConnectNet). Without it, tools return not_authorized (graceful).
# QMT_ENABLE_XTTRADE_QUERY=1
# Comma-separated account IDs allowed for xttrade queries (server-side allowlist;
# the agent cannot widen it).
# QMT_TRADE_ACCOUNTS=

# --- multi-broker tip ---
# Copy this file per instance (e.g. broker-a.env) with distinct INSTANCE / ports /
# authentication credentials / BROKER_PACK, then:
#   docker compose --env-file broker-a.env -p qmt-a up -d
