<Application
    x:Class="QmtMcp.Launcher.Desktop.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Segoe UI, PingFang SC, Microsoft YaHei UI, sans-serif" />
      <Setter Property="Background" Value="#F5F7F5" />
      <Setter Property="Foreground" Value="#202522" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#D7DDD9" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#66706A" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#237A50" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="16,8" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#A84B3F" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="16,8" />
    </Style>
  </Application.Styles>
  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/app-icon.ico" ToolTipText="QMT-MCP">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Open QMT-MCP" Click="OpenFromTray" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Exit" Click="ExitFromTray" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
